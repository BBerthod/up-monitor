# ── Grafana ───────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-before-deploy
GRAFANA_ROOT_URL=https://obs.example.com

# ── Prometheus ────────────────────────────────────────────────
# Time-series retention (default 15 days — fits CX11 20 GB disk)
PROMETHEUS_RETENTION=15d

# ── Alertmanager → Up webhook ─────────────────────────────────
# Bearer token issued by up.example.com (Settings → API Tokens)
UP_ALERTMANAGER_TOKEN=<your-api-token>

# ── Scrape targets (remote hosts) ─────────────────────────────
# node_exporter + cAdvisor must be reachable on these addresses
# Format: host:port  (no scheme)
UP_RADIANK_HOST=up.example.com
EXAMPLESTORE_HOST=example-shop-repo.example.com
WEBCOMPARE_HOST=example.org
