{
  "__inputs": [],
  "__requires": [
    { "type": "datasource", "id": "prometheus", "version": "1.0.0" },
    { "type": "datasource", "id": "loki",       "version": "1.0.0" }
  ],
  "annotations": { "list": [] },
  "description": "Example fleet: site uptime, TTFB, SSL health across .com / .de / .fr",
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            { "options": {
                "0": { "color": "red",   "index": 0, "text": "DOWN" },
                "1": { "color": "green", "index": 1, "text": "UP"   }
              }, "type": "value" }
          ],
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red",   "value": null },
            { "color": "green", "value": 1 }
          ]}
        }
      },
      "gridPos": { "h": 5, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value_and_name",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "probe_success{job=\"http-probe-example\"}",
          "legendFormat": "{{ instance }}",
          "refId": "A"
        }
      ],
      "title": "Site Status — Example Fleet",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2 },
          "unit": "s"
        }
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 5 },
      "id": 2,
      "options": {
        "legend": { "calcs": ["mean", "p95", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "probe_duration_seconds{job=\"http-probe-example\"}",
          "legendFormat": "{{ instance }}",
          "refId": "A"
        }
      ],
      "title": "TTFB — .com / .de / .fr",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "s", "min": 0 }
      },
      "gridPos": { "h": 5, "w": 12, "x": 0, "y": 13 },
      "id": 3,
      "options": {
        "colorMode": "value",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "probe_ssl_earliest_cert_expiry{job=\"http-probe-example\"} - time()",
          "legendFormat": "{{ instance }}",
          "refId": "A"
        }
      ],
      "title": "SSL Certificate TTL",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "percentunit" }
      },
      "gridPos": { "h": 5, "w": 12, "x": 12, "y": 13 },
      "id": 4,
      "options": {
        "colorMode": "value",
        "reduceOptions": { "calcs": ["mean"] }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "avg_over_time(probe_success{job=\"http-probe-example\"}[24h])",
          "legendFormat": "{{ instance }}",
          "refId": "A"
        }
      ],
      "title": "Uptime % — Last 24h",
      "type": "stat"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 18 },
      "id": 5,
      "options": {
        "dedupStrategy": "none",
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": false
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{compose_project=~\"example.*\"} |= `` | json | level=~\"error|critical\"",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "title": "Example Error Logs",
      "type": "logs"
    }
  ],
  "refresh": "1m",
  "schemaVersion": 39,
  "tags": ["example", "fleet", "radiank"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Example Fleet",
  "uid": "example-fleet",
  "version": 1
}
