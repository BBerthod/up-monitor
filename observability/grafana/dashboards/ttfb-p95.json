{
  "__inputs": [],
  "__requires": [
    { "type": "datasource", "id": "prometheus", "version": "1.0.0" }
  ],
  "annotations": { "list": [] },
  "description": "TTFB p95 per site — warm cache vs cold cache (probe_duration_seconds from blackbox_exporter)",
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2 },
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red",   "value": 3 }
            ]
          }
        }
      },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "legend": { "calcs": ["p95", "mean", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le, instance) (rate(probe_duration_seconds_bucket[5m])))",
          "legendFormat": "p95 {{ instance }}",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "avg by (instance) (probe_duration_seconds)",
          "legendFormat": "mean {{ instance }}",
          "refId": "B"
        }
      ],
      "title": "TTFB p95 — All Sites",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2 },
          "unit": "s"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "id": 2,
      "options": {
        "legend": { "calcs": ["lastNotNull"], "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "probe_http_duration_seconds{phase=\"connect\"}",
          "legendFormat": "connect {{ instance }}",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "probe_http_duration_seconds{phase=\"tls\"}",
          "legendFormat": "tls {{ instance }}",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "probe_http_duration_seconds{phase=\"processing\"}",
          "legendFormat": "processing {{ instance }}",
          "refId": "C"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "probe_http_duration_seconds{phase=\"transfer\"}",
          "legendFormat": "transfer {{ instance }}",
          "refId": "D"
        }
      ],
      "title": "TTFB Breakdown by Phase",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "s", "min": 0 }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "id": 3,
      "options": {
        "reduceOptions": { "calcs": ["p95"], "fields": "", "values": false },
        "colorMode": "background"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le, instance) (rate(probe_duration_seconds_bucket[1h])))",
          "legendFormat": "{{ instance }}",
          "refId": "A"
        }
      ],
      "title": "p95 TTFB — Current 1h",
      "type": "stat"
    }
  ],
  "refresh": "1m",
  "schemaVersion": 39,
  "tags": ["ttfb", "performance", "radiank"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "TTFB p95",
  "uid": "ttfb-p95",
  "version": 1
}
