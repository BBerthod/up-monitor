APP_NAME=Up
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Database
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=up
DB_USERNAME=postgres
DB_PASSWORD=

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Redis DB isolation — each concern uses a separate logical database
# DB 0 (default): general/locks  DB 1: cache  DB 2: queue  DB 3: sessions
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=2
REDIS_SESSION_DB=3

# Queue
QUEUE_CONNECTION=redis
# Explicit Redis connection for queue workers (uses REDIS_QUEUE_DB=2)
REDIS_QUEUE_CONNECTION=queue
# retry_after for the redis_long connection used by RunWarmSite (timeout=600s) and
# RunLighthouseAudit (timeout=180s). Must exceed the longest timeout to prevent
# premature requeue that would defeat ShouldBeUnique and cause duplicate runs.
REDIS_LONG_QUEUE_RETRY_AFTER=700

# Session
SESSION_DRIVER=redis
SESSION_ENCRYPT=false
# Points to the dedicated Redis session connection (REDIS_SESSION_DB=3)
# so volatile-lru eviction on the cache DB never touches active sessions.
SESSION_CONNECTION=session

# Cache
CACHE_STORE=redis

# Logging
LOG_CHANNEL=stack
LOG_LEVEL=debug
# Production: set LOG_CHANNEL=json to emit structured JSON to stderr
# (consumed by Docker log driver / log aggregators like Loki, Datadog, CloudWatch)
# LOG_CHANNEL=json

# Mail
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@up.dev"
MAIL_FROM_NAME="${APP_NAME}"

# Laravel Reverb (WebSocket)
REVERB_APP_ID=up-local
REVERB_APP_KEY=up-key
REVERB_APP_SECRET=up-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Push Notifications (VAPID)
# Generate with: php artisan webpush:vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VITE_VAPID_PUBLIC_KEY="${VAPID_PUBLIC_KEY}"

# Admin (used by AdminSeeder)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=password
ADMIN_NAME=Admin

# Google PageSpeed Insights (optional, higher rate limits with key)
GOOGLE_PAGESPEED_API_KEY=

# Bing Webmaster Tools (optional). When set, Bing click/impression/CTR data is
# collected for each Site that has a bing_url property configured.
BING_WEBMASTER_API_KEY=

# PostgreSQL backups (pg-backup service)
# Backups are written to the "backups" Docker volume at 03:00 daily.
# BACKUP_RETENTION_DAYS controls how many daily dumps are kept locally.
# Production: mount the volume to an S3-backed path or use a sidecar to ship to object storage.
BACKUP_RETENTION_DAYS=7

# AI narration for SEO digests (optional). Set AI_PROVIDER=gemini to enable.
AI_PROVIDER=null
AI_API_KEY=
AI_MODEL=gemini-2.5-flash

# Monitoring -- alerting thresholds
# Server load alerting (ratio load_average / CPU cores). Opt-in per server via the
# "CPU cores" field; these are the global default thresholds.
SERVER_LOAD_WARNING=0.85
SERVER_LOAD_CRITICAL=1.0
# Default CPU core count used when a Server record has no explicit core count set.
# 0 = auto-detect from the first metric (nproc reported by the agent).
SERVER_LOAD_CORES_DEFAULT=0

# Suppress uptime alerts for this many minutes after a Dokploy deploy hook fires.
DEPLOY_SILENCE_MINUTES=10

# Window (seconds) during which monitor-down alerts for the same server are collapsed
# into one (first alert fires immediately, subsequent ones are suppressed).
SERVER_ALERT_CORRELATION_WINDOW=120

# Optional token sent as X-Wk-Monitor when probing affiliate /go/ redirects.
AFFILIATE_MONITOR_TOKEN=

# Vikunja Kanban integration
# Turns persistent monitoring problems into board cards. Disabled by default:
# with VIKUNJA_ENABLED=false nothing is ever created.
# Run `php artisan vikunja:doctor` to verify the wiring and map sites to projects.
VIKUNJA_ENABLED=false
VIKUNJA_BASE_URL=
VIKUNJA_API_TOKEN=
VIKUNJA_FALLBACK_PROJECT_ID=1
VIKUNJA_LABEL_CLAUDE=
VIKUNJA_PERSISTENCE_HOURS=6
VIKUNJA_TRANSIENT_PERSISTENCE_HOURS=24
VIKUNJA_MAX_PER_RUN=5

# Board mode: every card lives in ONE shared project instead of one per
# site/server, and the old project becomes a "projet: <title>" label instead.
# 0 = OFF, keeps the legacy per-site-project behaviour untouched.
VIKUNJA_BOARD_PROJECT_ID=0
# Attached to every card in board mode — every card Up creates is the same sphere.
VIKUNJA_LABEL_SPHERE=
VIKUNJA_PROJECT_LABEL_PREFIX="projet: "
VIKUNJA_SERVER_PROJECT_TITLE=Infrastructure

# Per-site periodic reports (weekly/monthly, configured per Site in the UI).
# Comma-separated fallback recipients used when a Site has no report_recipients set.
SITE_REPORT_RECIPIENTS=
# Daily time (server timezone) at which per-site weekly/monthly reports are sent.
SITE_REPORT_SEND_TIME=07:30
